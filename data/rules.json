      "value_regex": "(?<![\\d.])(\\d+)\\s*天",
      "exclude_regex": "比价|工作日|小时"
    },
    {
      "key": "leave.annual_days",
      "label": "年假天数",
      "unit": "天",
      "question_terms": ["年假", "休假", "假期"],
      "sentence_contains": ["年假"],
      "value_regex": "(?<![\\d.])(\\d+)\\s*天",
      "negation_regex": "不享受年假|无年假|没有年假",
