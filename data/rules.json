    {
      "key": "product.refund_window",
      "label": "退款期限",
      "unit": "天",
      "question_terms": ["退款", "退订", "退费", "取消订阅"],
      "sentence_contains": ["退款"],
      "value_regex": "(?<![\\d.])(\\d+)\\s*天"
